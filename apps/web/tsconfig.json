{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@osshell/contract": ["../../packages/contract/src/index.ts"],
      "@osshell/runtime": ["../../packages/runtime/src/index.ts"]
    }
  },
  "include": ["src"]
}
