NODE_ENV=development
# Local adapter is deliberately explicit; production must use a real Trust ID provider.
XPERIENCE_DEV_AUTH=true
PORT=4100
DATABASE_URL=postgresql://xperience:change-me@localhost:5432/xperience
# Explicit local/test only — forbidden when NODE_ENV=production
# XPERIENCE_REPOSITORY=memory
XPERIENCE_CONSOLE_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:5176
# Xperience developer/admin console: npm run dev:xperience (5174)
# OS Experience mobile surface: npm run dev:xperience-mobile (5175)
# OS Experience consumer web: npm run dev:os-experience (5176)
# VITE_XPERIENCE_API_URL=http://localhost:4100
# VITE_XPERIENCE_USER_ID=user-1
# VITE_XPERIENCE_USER_NAME=Melvin
