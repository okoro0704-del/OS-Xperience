NODE_ENV=development
# Local adapter is deliberately explicit; production must use a real Trust ID provider.
XPERIENCE_DEV_AUTH=true
PORT=4100
DATABASE_URL=postgresql://xperience:change-me@localhost:5432/xperience
# Explicit local/test only — forbidden when NODE_ENV=production
# XPERIENCE_REPOSITORY=memory
XPERIENCE_CONSOLE_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:5176
# Xperience developer/admin console: npm run dev:xperience (5174)
# OS Experience mobile surface: npm run dev:xperience-mobile (5175)
# OS Experience consumer web: npm run dev:os-experience (5176)
# VITE_XPERIENCE_API_URL=http://localhost:4100
# Production Netlify builds use VITE_XPERIENCE_API_URL from netlify.toml
# VITE_XPERIENCE_USER_ID=user-1
# VITE_XPERIENCE_USER_NAME=Melvin
# LifeOS → Directory thin adapter (read-only catalog projection; not a second Application DB)
# LIFEOS_DIRECTORY_CATALOG_URL=https://lifeos.example/.well-known/os-experience-directory.json
# LIFEOS_DIRECTORY_CATALOG_JSON={"applications":[]}
# Optional management-entry grants (participant ↔ application). Never invent /admin URLs here.
# XPERIENCE_MANAGEMENT_ACCESS_JSON=[{"applicationId":"ins_example","participantIds":["user-1"]}]
# Production consumer participant auth (USER only) until Trust ID is connected:
# XPERIENCE_PARTICIPANT_AUTH=true
# XPERIENCE_CONSOLE_ORIGINS=https://xperience.getlifeos.app,https://os-xperience.netlify.app,http://localhost:5176

