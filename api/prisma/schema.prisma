generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum ReviewState {
 DRAFT
 SUBMITTED
 UNDER_REVIEW
 CHANGES_REQUIRED
 APPROVED
 PUBLISHED
 SUSPENDED
 REVOKED
}
enum EvidenceType {
 DOMAIN
 WELL_KNOWN_ENDPOINT
 GITHUB
 DEPLOYMENT_PROVIDER
 XPERIENCE_ENDPOINT
}
enum EvidenceStatus {
 PENDING
 VERIFIED
 FAILED
 UNAVAILABLE
}
enum CapabilityReviewState {
 REQUESTED
 APPROVED
 REJECTED
 REQUIRES_CHANGES
}
enum ExperienceMembershipStatus {
 ACTIVE
 PAUSED
}
model Developer {
 id String @id @default(cuid())
 email String @unique
 identities DeveloperIdentity[]
 applications Application[]
 createdAt DateTime @default(now())
}
model DeveloperIdentity {
 id String @id @default(cuid())
 developerId String
 provider String
 subject String
 developer Developer @relation(fields: [developerId], references: [id])
 @@unique([provider, subject])
}
model Application {
 id String @id
 manifest Json
 state ReviewState @default(DRAFT)
 revision Int @default(1)
 developerId String
 developer Developer @relation(fields: [developerId], references: [id])
 manifests ApplicationManifest[]
 manifestRevisions ManifestRevision[]
 capabilities ApplicationCapability[]
 evidence VerificationEvidence[]
 reviews Review[]
 publications Publication[]
 audit AuditEvent[]
 experienceSelections ExperienceSelection[]
 @@index([developerId, state])
}
model ExperienceSelection {
 id String @id @default(cuid())
 participantId String
 applicationId String
 status ExperienceMembershipStatus @default(ACTIVE)
 addedAt DateTime @default(now())
 lastOpenedAt DateTime?
 application Application @relation(fields: [applicationId], references: [id])
 @@unique([participantId, applicationId])
 @@index([participantId, status])
}
model ApplicationManifest {
 id String @id @default(cuid())
 applicationId String
 revision Int
 claim Json
 application Application @relation(fields: [applicationId], references: [id])
 @@unique([applicationId, revision])
}
model ManifestRevision {
 id String @id @default(cuid())
 applicationId String
 revision Int
 claim Json
 application Application @relation(fields: [applicationId], references: [id])
 createdAt DateTime @default(now())
 @@unique([applicationId, revision])
}
model ApplicationCapability {
 id String @id @default(cuid())
 applicationId String
 capability String
 status CapabilityReviewState @default(REQUESTED)
 application Application @relation(fields: [applicationId], references: [id])
 @@unique([applicationId, capability])
 @@index([status])
}
model VerificationEvidence {
 id String @id @default(cuid())
 applicationId String
 type EvidenceType
 locator String
 status EvidenceStatus @default(PENDING)
 application Application @relation(fields: [applicationId], references: [id])
 attempts VerificationAttempt[]
 @@index([applicationId, status])
}
model VerificationAttempt {
 id String @id @default(cuid())
 evidenceId String
 outcome String
 detail String?
 evidence VerificationEvidence @relation(fields: [evidenceId], references: [id])
 createdAt DateTime @default(now())
}
model Review {
 id String @id @default(cuid())
 applicationId String
 reviewerId String
 state ReviewState
 note String?
 application Application @relation(fields: [applicationId], references: [id])
 actions ReviewAction[]
 createdAt DateTime @default(now())
}
model ReviewAction {
 id String @id @default(cuid())
 reviewId String
 action String
 actorId String
 detail String?
 review Review @relation(fields: [reviewId], references: [id])
 createdAt DateTime @default(now())
}
model Publication {
 id String @id @default(cuid())
 applicationId String
 status String
 application Application @relation(fields: [applicationId], references: [id])
 createdAt DateTime @default(now())
}
model AuditEvent {
 id String @id @default(cuid())
 applicationId String?
 actorId String
 actorType String
 action String
 previousState String?
 newState String?
 reason String?
 detail Json?
 application Application? @relation(fields: [applicationId], references: [id])
 createdAt DateTime @default(now())
 @@index([applicationId, createdAt])
}
